# Opal environment variables. Copy to `.env.local` (git-ignored) or export in your shell.
# Vite only exposes variables prefixed with VITE_ to the frontend; they are baked in at build time,
# so never put real secrets in VITE_* for a distributed build.

# ── Frontend (browser-mode development / e2e) ────────────────────────────────────────────────
# Connect to an external `opencode serve` instead of the Tauri sidecar. Used by `pnpm dev` in a
# plain browser; ignored inside the desktop app, which always uses its private sidecar.
VITE_OPENCODE_URL=http://127.0.0.1:4096
# Basic-auth password of that server (username is always "opencode"); must match the server's
# OPENCODE_PASSWORD. Dev-only value — do not reuse a real password.
VITE_OPENCODE_PASSWORD=dev
# 1 = run the UI on the in-memory mock runtime (no server needed). Used by `pnpm test:e2e`.
VITE_OPAL_MOCK=0

# ── macOS packaging (scripts/build-mac.sh) ────────────────────────────────────────────────────
# Code-signing identity (must exist in your login keychain: `security find-identity -v -p codesigning`).
# Leave unset to use the only "Developer ID Application" identity in your keychain.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
# notarytool keychain profile created with `xcrun notarytool store-credentials opal-notary …`.
APPLE_NOTARY_PROFILE=opal-notary

# ── Optional ───────────────────────────────────────────────────────────────────────────────────
# Sidecar version fetched by scripts/fetch-opencode.mjs (default: the pinned version, 2.2.5).
# OPENCODE_VERSION=2.2.5
# Help-menu links (baked into the Rust binary at compile time).
# OPAL_REPO_URL=https://github.com/ditistijn/opal
# Port for the Playwright smoke test's dev server (default 1430).
# E2E_PORT=1430
